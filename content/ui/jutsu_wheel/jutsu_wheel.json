{
  "_doc": "Jutsu wheel UI (radial selector). Hold the button to open, aim with the mouse, click (or release) to activate. All sizes in UI pixels at 1x: scale the CanvasLayer (x3 or x4) with nearest filtering.",
  "input": {
    "open": "hold the 'jutsu_wheel' action (e.g. Q / middle mouse / LB) for 0.15 s",
    "select": "mouse direction from the wheel center",
    "deadzone_px": 18,
    "confirm": "left click on the hovered slot (also confirms on release if 'confirm_on_release' is true)",
    "confirm_on_release": false,
    "cancel": "release the hold button without clicking, or right click",
    "slot_from_angle": "slot = posmod(roundi((mouse - center).angle() / (PI/4)), 8)  # same order as the 8-dir fx sheets"
  },
  "time": {
    "time_scale_while_open": 0.2,
    "note": "slow the game, not the UI (UI uses PROCESS_MODE_ALWAYS / unscaled delta)",
    "screen_dim": {
      "color": "#000000",
      "alpha": 0.35
    }
  },
  "anim": {
    "open_sec": 0.12,
    "open": "wheel scale 0.6 -> 1.0, alpha 0 -> 1 (ease out back)",
    "slots_stagger_sec": 0.012,
    "close_sec": 0.08,
    "hover": "slot scale 1.0 -> 1.15 over 0.06 s + highlight wedge + hub pointer",
    "confirm": "the chosen slot flashes white for 0.06 s and pops to 1.3, then the wheel closes"
  },
